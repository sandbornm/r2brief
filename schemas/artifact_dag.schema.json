{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r2b.local/schemas/artifact_dag.schema.json",
  "title": "r2b artifact DAG",
  "type": "object",
  "required": ["schema_version", "sha256", "nodes", "edges"],
  "properties": {
    "schema_version": { "const": "r2b.artifact_dag.v1" },
    "subject": { "type": "string" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generated_at": { "type": "string" },
    "tools": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "object" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "source_tools"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "container",
              "partition",
              "filesystem",
              "file",
              "elf",
              "pe",
              "macho",
              "fat_macho",
              "script",
              "function",
              "import",
              "string",
              "endpoint",
              "config_key"
            ]
          },
          "label": { "type": "string" },
          "sha256": { "type": ["string", "null"] },
          "parent_id": { "type": ["string", "null"] },
          "parent_offset": { "type": ["integer", "null"] },
          "size": { "type": ["integer", "null"] },
          "path": { "type": ["string", "null"] },
          "source_tools": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number" },
          "properties": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "source", "target", "source_tool"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "source_tool": { "type": "string" },
          "parent_offset": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
