{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sandbornm/r2brief/schemas/briefing.schema.json",
  "title": "r2b Analysis Briefing",
  "description": "Ranked binary regions with compact dis/asm snippets and concrete LLM asks.",
  "type": "object",
  "required": ["schema_version", "binary", "summary", "regions", "overall_ask", "next_steps", "handoff"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "r2b.briefing.v1" },
    "binary": { "type": "string" },
    "subject": { "type": "object" },
    "summary": { "type": "string" },
    "overall_ask": { "type": "string" },
    "next_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    },
    "handoff": {
      "type": "object",
      "description": "Deterministic planner view: compact regions + next r2b argv. No model.",
      "properties": {
        "schema_version": { "const": "r2b.handoff.v1" },
        "binary": { "type": "string" },
        "record_id": { "type": ["string", "null"] },
        "summary": { "type": "string" },
        "subject": { "type": "object" },
        "regions": { "type": "array" },
        "next_argv": { "type": "array", "items": { "type": "string" } },
        "named_imports": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Dangerous imports that verify --import can take but next_argv does not auto-queue (strcpy/memcpy/sprintf)."
        },
        "verified_sites": { "type": "array" },
        "decompile_addrs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Unique containing-function VAs from verified_imports. Not auto-queued."
        },
        "requires_scope": { "type": "boolean" },
        "scope_options": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ask_result": {
      "type": "object",
      "description": "Present when --ask ran; structured answers for a harness.",
      "properties": {
        "ok": { "type": "boolean" },
        "provider": { "type": ["string", "null"] },
        "error": { "type": "string" },
        "answers": { "type": "array" }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "why", "score", "ask"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "why": { "type": "string" },
          "score": { "type": "number" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "ask": { "type": "string" },
          "next_actions": { "type": "array", "items": { "type": "string" } },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["action", "result_ref", "output_sha256"],
              "properties": {
                "action": { "type": "integer", "minimum": 1 },
                "result_ref": { "type": "string" },
                "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          },
          "snippet": {
            "type": ["object", "null"],
            "properties": {
              "source": { "type": "string" },
              "kind": { "type": "string" },
              "text": { "type": "string" },
              "address": { "type": ["string", "null"] },
              "function": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
