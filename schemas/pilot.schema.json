{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "r2b pilot plan",
  "description": "The JSON object the planner LLM must emit for a goal. The executor in r2b/pilot.py validates against these same rules by hand (no runtime dependency on this file).",
  "type": "object",
  "required": ["goal", "steps"],
  "additionalProperties": false,
  "properties": {
    "goal": {"type": "string", "maxLength": 400},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["verb", "target", "why"],
        "additionalProperties": false,
        "properties": {
          "verb": {"type": "string", "enum": ["analyze", "brief", "records", "insights"]},
          "target": {
            "type": "string",
            "description": "Existing path under the lab root (samples/ or work/) for analyze/brief; 'list' or a 64-hex record id for records; a tag for insights."
          },
          "ask": {"type": "string", "maxLength": 300},
          "ask_regions": {"type": "integer", "minimum": 0, "maximum": 3},
          "quick": {"type": "boolean", "default": true},
          "tag": {"type": "string", "maxLength": 40},
          "why": {"type": "string", "maxLength": 200}
        }
      }
    }
  }
}
