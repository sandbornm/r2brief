{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sandbornm/r2brief/schemas/review.schema.json",
  "title": "r2b deterministic/model region review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_id",
    "mode",
    "thesis",
    "briefing",
    "candidate_count",
    "base_order",
    "model_order",
    "disagreements",
    "model"
  ],
  "properties": {
    "schema_version": { "const": "r2b.review.v1" },
    "prompt_id": { "const": "r2b.review.prompt.v1" },
    "mode": { "enum": ["rules", "llm", "both"] },
    "thesis": { "type": ["string", "null"] },
    "briefing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sha256", "candidate_sha256"],
      "properties": {
        "schema_version": { "const": "r2b.briefing.v1" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "candidate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "candidate_count": { "type": "integer", "minimum": 1 },
    "base_order": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/baseOrderEntry" }
    },
    "model_order": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/modelOrderEntry" }
        }
      ]
    },
    "disagreements": {
      "type": "array",
      "items": { "$ref": "#/$defs/disagreement" }
    },
    "model": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/modelMetadata" }
      ]
    }
  },
  "$defs": {
    "briefingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sha256", "candidate_sha256"],
      "properties": {
        "schema_version": { "const": "r2b.briefing.v1" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "candidate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "baseOrderEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "region_id", "title", "score", "evidence_id"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "region_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "score": { "type": "number" },
        "evidence_id": { "type": "string", "minLength": 1 }
      }
    },
    "modelOrderEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "region_id", "reason", "evidence_ids"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "region_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "base_rank", "model_rank", "rank_shift"],
      "properties": {
        "region_id": { "type": "string", "minLength": 1 },
        "base_rank": { "type": "integer", "minimum": 1 },
        "model_rank": { "type": "integer", "minimum": 1 },
        "rank_shift": { "type": "integer" }
      }
    },
    "modelMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "transport",
        "response_id",
        "usage",
        "finish_reason",
        "latency_ms",
        "tool_rounds"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "transport": { "type": "string", "minLength": 1 },
        "response_id": { "type": ["string", "null"] },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "total_tokens"],
          "properties": {
            "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "total_tokens": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "finish_reason": { "type": ["string", "null"] },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "tool_rounds": { "const": 0 }
      }
    }
  }
}
